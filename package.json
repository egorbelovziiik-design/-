{
  "name": "wincode-ai",
  "version": "1.0.0",
  "description": "WinCode AI — professional AI IDE for Windows: Java, Kotlin, Minecraft development, AI Agent",
  "main": "./out/main/index.js",
  "author": "WinCode AI Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:win:setup": "electron-vite build && electron-builder --win nsis --x64",
    "dist:win:portable": "electron-vite build && electron-builder --win portable --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "framer-motion": "^12.4.0",
    "lucide-react": "^0.474.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.wincode.ai",
    "productName": "WinCode AI",
    "copyright": "Copyright © 2026 WinCode AI Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "WinCode-AI-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinCode AI",
      "artifactName": "WinCode-AI-Setup.${ext}"
    },
    "portable": {
      "artifactName": "WinCode-AI-Portable.${ext}"
    },
    "fileAssociations": [
      { "ext": "java", "name": "Java Source", "role": "Editor" },
      { "ext": "kt", "name": "Kotlin Source", "role": "Editor" },
      { "ext": "py", "name": "Python Source", "role": "Editor" },
      { "ext": "ts", "name": "TypeScript Source", "role": "Editor" },
      { "ext": "js", "name": "JavaScript Source", "role": "Editor" }
    ]
  }
}
